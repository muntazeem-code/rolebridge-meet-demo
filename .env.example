# Optional Docker Compose settings. Copy to .env in the repository root to override
# these defaults. Application credentials stay in backend/.env, not this file.
BACKEND_ENV_FILE=./backend/.env
HTTP_PORT=80
CLIENT_URL=http://localhost

# Local image names. A deployment can override the registry and release tag.
ECR_REGISTRY=local
IMAGE_TAG=local

# If HTTP_PORT=8080, also set CLIENT_URL=http://localhost:8080.
# On a server, CLIENT_URL must be the actual public frontend origin (including HTTPS).
# BACKEND_ENV_FILE can point to an existing server file, e.g. /opt/rolebridge/backend.env.
