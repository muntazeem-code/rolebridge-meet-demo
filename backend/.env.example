# Copy this file to backend/.env. Never commit the filled .env file.
# Run backend commands from backend/ so dotenv can load this file.

# Required local application settings
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/roles_dashboard
CLIENT_URL=http://localhost:5174

# Docker: Compose supplies CLIENT_URL from the root .env (default http://localhost).
# Keep an existing Atlas/remote MONGO_URI. For MongoDB on the Docker Desktop host,
# use mongodb://host.docker.internal:27017/roles_dashboard instead of 127.0.0.1.
# MongoDB must be running and accept connections from Docker; Compose does not start it.

# REQUIRED: generate a random secret and paste it here before logging in.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required by `npm run seed` to create the first Super Admin.
# Choose your own password (8-128 characters). Quote values containing # or spaces.
# Reseeding does not reset an existing account's password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Optional for local invitation onboarding; required for actual email delivery.
# Leave all four credential/sender values blank to print development invitation
# links in the backend terminal. Meeting emails do not have that fallback.
# Use your provider's SMTP host, credentials, and authorized sender.
# SMTP_PORT=465 enables TLS; SMTP_PORT=587 uses STARTTLS when offered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Required only to schedule real Zoom meetings.
# Use an activated Server-to-Server OAuth app; the host must be in that account.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=

# Optional Zoom request timeout in milliseconds (code default: 10000).
ZOOM_TIMEOUT_MS=10000

# Advanced/test overrides only. Leave commented for normal use.
# ZOOM_TOKEN_URL=https://zoom.us/oauth/token
# ZOOM_API_BASE_URL=https://api.zoom.us/v2

# Local Whisper and Zoom Recording Watcher settings
PYTHON_EXECUTABLE=python
WHISPER_MODEL=base
WHISPER_LANGUAGE=English
WHISPER_DEVICE=cpu
ZOOM_RECORDING_DIR=
WHISPER_OUTPUT_DIR=./storage/transcripts
