# Copy this file to frontend/.env, then restart Vite.
# Include /api; update the port if you change the backend's PORT.
VITE_API_URL=http://localhost:5001/api

# Docker ignores frontend .env files and builds with VITE_API_URL=/api.
# No frontend .env is needed for Docker; Nginx forwards /api to the backend.

# VITE_ values are public and included in the browser bundle.
# Keep all passwords, JWT secrets, MongoDB URIs, and Zoom credentials in backend/.env.
